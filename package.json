{
  "name": "foolscap-web-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "companion": "tsx companion/cli.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint src companion shared desktop api tests",
    "verify": "pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "connect:build": "node tools/build-connect.mjs",
    "connect:dev": "pnpm connect:build && electron desktop-app",
    "connect:package": "pnpm connect:build && electron-builder --config electron-builder.yml --mac --arm64",
    "test:connect": "pnpm connect:build && playwright test --config playwright.connect.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.50.0",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vercel/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
